{
  "name": "neuronest",
  "version": "0.2.906",
  "description": "NeuroNest - The AI Coding SuperAgent",
  "author": "NeuroNest <admin@neuronest.cc>",
  "license": "BUSL-1.1",
  "private": true,
  "main": "dist/main/electron-app.js",
  "scripts": {
    "build": "node scripts/bump-version.mjs && node scripts/compile-main.mjs && npm run bundle:preload && npm run bundle:guest-preload && node scripts/copy-renderer.mjs",
    "build:nobump": "node scripts/compile-main.mjs && npm run bundle:preload && npm run bundle:guest-preload && node scripts/copy-renderer.mjs",
    "bundle:preload": "esbuild src/renderer/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/renderer/preload.js --sourcemap",
    "bundle:guest-preload": "esbuild src/renderer/webview-guest-preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist/renderer/webview-guest-preload.js --sourcemap",
    "start": "npx @electron/rebuild -f -w better-sqlite3,onnxruntime-node && npm run build && electron .",
    "cli": "npm rebuild better-sqlite3 && npm run build && node dist/cli/index.js --cli",
    "agent:quality": "node dist/agent-catalog/agent-quality-cli.js",
    "test": "npm rebuild better-sqlite3 2>/dev/null; vitest --run",
    "test:ci": "vitest --run --reporter=verbose",
    "test:watch": "vitest",
    "test:static": "vitest --run tests/static/ .static.test.ts",
    "check:proxy-separation": "node scripts/check-proxy-separation.mjs",
    "check:agent-count": "node scripts/derive-agent-count.mjs --validate",
    "check:migrations": "node scripts/check-migration-contiguity.mjs",
    "check:ipc": "node scripts/check-ipc-allowlist.mjs",
    "check:refs": "node scripts/check-referenced-files.mjs",
    "check:deps": "node scripts/check-dependency-pins.mjs",
    "check:ratchets": "node scripts/check-ratchets.mjs",
    "check:orphans": "node scripts/check-orphans.mjs",
    "check:architecture": "node scripts/check-structured-renderer-architecture.mjs",
    "check:gates": "node scripts/check-publication-gates.mjs",
    "check:gates:session": "node scripts/check-publication-gates.mjs --artifact session-mcp",
    "check:gates:runtime": "node scripts/check-publication-gates.mjs --artifact runtime-mcp",
    "check:gates:schema": "node scripts/check-publication-gates.mjs --artifact schema",
    "check:gates:ui": "node scripts/check-publication-gates.mjs --artifact ui",
    "check:gates:dry-run": "node scripts/check-publication-gates.mjs --dry-run",
    "check:spec-graph": "node scripts/check-spec-graph.mjs",
    "check:spec-graph:blocking": "node scripts/check-spec-graph.mjs --blocking --report .kiro/specs/neuronest-requirements/baseline/spec-graph-report.json --evidence .kiro/specs/neuronest-requirements/baseline/spec-graph-evidence.json",
    "check:spec-graph:selftest": "node scripts/check-spec-graph.selftest.mjs",
    "lint": "eslint src/ packages/",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"packages/**/*.{ts,tsx}\"",
    "security-lint": "bash scripts/security-lint.sh",
    "check:renderer-size": "node scripts/check-renderer-file-size.mjs",
    "bench:tick": "npm run build:nobump && node bench/event-log-tick.mjs",
    "bench:reducer-warm": "npm run build:nobump && node bench/reducer-warm.mjs",
    "bench:reducer-cold": "npm run build:nobump && node bench/reducer-cold.mjs",
    "bench:hashline": "node bench/hashline-perf.mjs",
    "bench:all": "node scripts/check-benchmarks.mjs",
    "bench:update": "node scripts/check-benchmarks.mjs --update",
    "dev:vite": "electron-vite dev",
    "build:vite": "electron-vite build",
    "typecheck:renderer": "tsc --noEmit -p tsconfig.renderer.json",
    "preview:vite": "electron-vite preview",
    "rebuild:native": "node scripts/conditional-rebuild.mjs",
    "dist": "npm run rebuild:native && npm run build:nobump && electron-builder --mac",
    "dist:mac": "npm run rebuild:native && npm run build:nobump && electron-builder --mac",
    "dist:mac:arm64": "npm run rebuild:native && npm run build:nobump && electron-builder --mac --arm64",
    "dist:mac:x64": "npm run rebuild:native && npm run build:nobump && electron-builder --mac --x64",
    "dist:mac:universal": "CSC_IDENTITY_AUTO_DISCOVERY=false CSC_LINK='' npm run rebuild:native && npm run build:nobump && electron-builder --mac --universal -c.mac.identity=null",
    "dist:win": "npm run rebuild:native && npm run build:nobump && electron-builder --win",
    "dist:linux": "npm run rebuild:native && npm run build:nobump && electron-builder --linux",
    "dist:all": "npm run rebuild:native && npm run build:nobump && electron-builder -mwl",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "changeset:version": "changeset version",
    "release": "changeset version && changeset tag"
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@blackwell-systems/gcf": "2.1.2",
    "@peculiar/x509": "2.0.0",
    "@popperjs/core": "2.11.8",
    "@sentry/electron": "7.0.0",
    "@simplewebauthn/server": "13.3.0",
    "@slack/bolt": "4.6.0",
    "@types/ws": "8.18.1",
    "archiver": "7.0.1",
    "better-sqlite3": "13.0.2",
    "chokidar": "5.0.0",
    "discord.js": "14.26.1",
    "electron-updater": "6.8.3",
    "fast-glob": "3.3.2",
    "grammy": "1.42.0",
    "headroom-ai": "0.22.4",
    "highlight.js": "11.11.1",
    "lucide-static": "1.14.0",
    "markdown-it": "14.1.1",
    "modern-monaco": "0.4.2",
    "monaco-editor": "0.55.1",
    "node-addon-api": "8.7.0",
    "nodemailer": "9.0.0",
    "onnxruntime-node": "1.26.0",
    "openai": "6.33.0",
    "qrcode": "1.5.4",
    "reflect-metadata": "0.2.2",
    "tar": "7.5.13",
    "tippy.js": "6.3.7",
    "tm-grammars": "1.31.15",
    "tm-themes": "1.12.2",
    "twemoji-parser": "14.0.0",
    "uuidv7": "1.2.1",
    "web-tree-sitter": "0.24.7",
    "ws": "8.20.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@changesets/cli": "2.31.0",
    "@electron/rebuild": "4.0.0",
    "@eslint/js": "9.15.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/jsdom": "21.1.7",
    "@types/markdown-it": "14.1.2",
    "@types/node": "22.15.0",
    "@types/tar": "6.1.13",
    "@typescript-eslint/eslint-plugin": "8.0.0",
    "@typescript-eslint/parser": "8.0.0",
    "electron": "43.0.0",
    "electron-builder": "26.0.0",
    "electron-vite": "5.0.0",
    "esbuild": "0.28.1",
    "eslint": "9.15.0",
    "fast-check": "4.0.0",
    "globals": "17.7.0",
    "jsdom": "29.0.2",
    "prettier": "3.3.0",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.neuronest.app",
    "productName": "NeuroNest",
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "buildDependenciesFromSource": false,
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "files": [
      "dist/**/*",
      "!dist/**/*.test.*",
      "!dist/**/__tests__/**",
      "assets/voice-models/**/*",
      "LICENSE"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/onnxruntime-node/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**",
      "node_modules/node-addon-api/**"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true,
      "singleArchFiles": "Contents/Resources/app.asar.unpacked/**",
      "x64ArchFiles": "Contents/Resources/app.asar.unpacked/**",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "NeuroNest-${version}-mac-universal.${ext}"
    },
    "dmg": {
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "signtoolOptions": {
        "sign": "./scripts/sign-windows.cjs",
        "signingHashAlgorithms": [
          "sha256"
        ],
        "publisherName": "NeuroNest"
      },
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "NeuroNest-Setup-${version}-win-x64.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NeuroNest"
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Development",
      "description": "NeuroNest - The AI Coding SuperAgent",
      "desktop": {
        "entry": {
          "StartupNotify": "true",
          "Terminal": "false",
          "Type": "Application",
          "Categories": "Development;IDE;"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "deb": {
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libgbm1"
      ]
    },
    "rpm": {
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "mesa-libgbm"
      ]
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://neuronest.cc/updates",
        "channel": "latest"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "@electron/rebuild": {
      "@electron/node-gyp": "npm:node-gyp@^11.2.0"
    }
  }
}
